# Бэкенд админки (../backend). Обе переменные — серверные:
# токены и запросы к API не должны попадать в браузер, поэтому
# никаких NEXT_PUBLIC_ здесь быть не должно.

# Базовый URL API вместе с префиксом версии.
API_URL=http://localhost:4000/api/v1

# Origin бэкенда без префикса — нужен для картинок из /uploads
# (images.remotePatterns в next.config.ts).
API_ORIGIN=http://localhost:4000

# Публичный адрес сайта: canonical, sitemap, JSON-LD. Встраивается при сборке;
# в прод-сборке обязателен (в compose берётся из SITE_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
