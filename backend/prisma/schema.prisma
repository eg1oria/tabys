// Схема админки Tabys: каталог (категории, товары, фасеты), заявки, медиа, доступ.
// Контент страниц и реквизиты компании пока живут в frontend/src/lib/content/*
// и в этой схеме сознательно отсутствуют.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // moduleFormat не указываем: Prisma 7.10 выводит ESM из package.json
  // "type": "module" + tsconfig moduleResolution: nodenext.
}

datasource db {
  provider = "postgresql"
  // url здесь не указывается — в Prisma 7 он задаётся в prisma.config.ts.
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum AdminRole {
  OWNER
  EDITOR
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

// ──────────────────────────── доступ ────────────────────────────

model AdminUser {
  id           String    @id @default(uuid(7))
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  uploadedMedia MediaAsset[]
  assignedLeads Lead[]
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Хеш токена, а не сам токен: утечка дампа базы не должна давать доступ.
  tokenHash String    @unique
  /// Семейство ротации: предъявление отозванного токена отзывает всё семейство.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ──────────────────────────── медиа ─────────────────────────────

model MediaAsset {
  id           String   @id @default(uuid(7))
  /// Путь относительно UPLOAD_DIR, например "2026/10/<uuid>.jpg".
  storageKey   String   @unique
  originalName String
  mimeType     String
  bytes        Int
  width        Int?
  height       Int?
  /// Крошечный base64 для placeholder="blur" в next/image.
  blurDataUrl  String?
  /// { "400": "...-400.webp", "800": "...-800.webp" }
  derivatives  Json?
  alt          String   @default("")
  createdAt    DateTime @default(now())
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  categories    Category[]
  products      Product[]
  productImages ProductImage[]

  @@index([createdAt])
}

// ──────────────────────── фасеты каталога ──────────────────────

/// Группа фильтров: type, volume, productivity, material, application.
/// Таблица, а не enum, — чтобы админ добавлял значения без миграции.
model FacetGroup {
  id           String  @id @default(uuid(7))
  key          String  @unique
  title        String
  /// true для "type": у категории ровно одно значение. Остальные допускают несколько.
  singleSelect Boolean @default(false)
  sortOrder    Int     @default(0)

  values FacetValue[]

  @@index([sortOrder])
}

model FacetValue {
  id        String     @id @default(uuid(7))
  groupId   String
  group     FacetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  value     String
  label     String
  sortOrder Int        @default(0)

  categories CategoryFacetValue[]
  products   ProductFacetValue[]

  @@unique([groupId, value])
  @@index([groupId, sortOrder])
}

model CategoryFacetValue {
  categoryId   String
  facetValueId String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  facetValue   FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade)

  @@id([categoryId, facetValueId])
  @@index([facetValueId])
}

model ProductFacetValue {
  productId    String
  facetValueId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  facetValue   FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade)

  @@id([productId, facetValueId])
  @@index([facetValueId])
}

// ──────────────────────────── каталог ──────────────────────────

model Category {
  id          String        @id @default(uuid(7))
  slug        String        @unique
  title       String
  /// Короткое имя для боковой панели каталога.
  short       String
  description String
  /// Пункты крупной карточки на главной.
  highlights  String[]
  /// Витринное число позиций. У 3 из 12 категорий оно расходится с реальным
  /// списком (у торцевых уплотнений 20 против 5), поэтому это переопределение,
  /// а не вычисляемое значение: публично отдаём positionCount ?? _count.products.
  positionCount Int?
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  seoTitle       String?
  seoDescription String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  facetValues CategoryFacetValue[]
  products    Product[]

  @@index([status, sortOrder])
}

model Product {
  id          String        @id @default(uuid(7))
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  /// Часть адреса /oborudovanie/<категория>/<товар>, уникален в категории.
  slug        String
  /// Артикул: редактор вводит сам, поэтому проверяем уникальность в сервисе.
  sku         String?       @unique
  description String?
  /// { "Объём": "1 000 л", "Материал": "AISI 304" }
  specs       Json?
  priceFrom      Decimal? @db.Decimal(12, 2)
  priceOnRequest Boolean  @default(true)
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  facetValues ProductFacetValue[]
  /// Галерея. imageId остаётся главным фото: публичный сайт читает только его.
  images      ProductImage[]

  @@unique([categoryId, slug])
  @@index([categoryId, status, sortOrder])
}

/// Дополнительные фото товара. Первое по sortOrder дублируется в Product.imageId.
model ProductImage {
  id        String     @id @default(uuid(7))
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
}

// ──────────────────────────── заявки ───────────────────────────

model Lead {
  id           String     @id @default(uuid(7))
  name         String
  /// Как ввёл пользователь.
  phone        String
  /// Только цифры — для поиска и поиска дублей.
  phoneDigits  String
  email        String?
  message      String?
  status       LeadStatus @default(NEW)
  /// Согласие на обработку — важна именно отметка времени, а не факт галочки.
  consentAt    DateTime
  ip           String?
  userAgent    String?
  internalNote String?
  assignedToId String?
  assignedTo   AdminUser? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notifiedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  attachments LeadAttachment[]

  @@index([status, createdAt])
  @@index([phoneDigits])
  @@index([createdAt])
}

model LeadAttachment {
  id           String   @id @default(uuid(7))
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// "leads/2026/10/<uuid>.pdf" — наружу не раздаётся, только через админку.
  storageKey   String   @unique
  originalName String
  mimeType     String
  bytes        Int
  createdAt    DateTime @default(now())

  @@index([leadId])
}

// ──────────────────────────── аудит ────────────────────────────

model AuditLog {
  id        String     @id @default(uuid(7))
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
