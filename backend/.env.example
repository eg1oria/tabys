NODE_ENV=development
PORT=4000

# Локальный Postgres (Homebrew), роль egor
DATABASE_URL="postgresql://egor@localhost:5432/tabys?schema=public"

# Фронтенд в dev; через запятую можно добавить прод-домен
CORS_ORIGINS=http://localhost:3000

# Не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000

# Сколько дней хранить журнал действий админки. 0 — вечно.
AUDIT_RETENTION_DAYS=365

# Первый администратор — используется только сид-скриптом
SEED_ADMIN_EMAIL=admin@tabys.kz
SEED_ADMIN_PASSWORD=

# Кому доверять X-Forwarded-For. Пусто — никому: тогда все запросы от Next
# (вход, заявки) идут с одного IP и делят один лимит. В проде пустое значение
# не пропустит проверка окружения; compose.yaml ставит uniquelocal.
# Локально с фронтендом на том же хосте: loopback.
# Внимание: доверять только адресам настоящего прокси, иначе IP в заголовке
# подделает кто угодно и обойдёт лимиты.
TRUST_PROXY=loopback

# Redis для счётчиков лимитов запросов. Пусто — счётчики в памяти процесса:
# локально можно, в проде бэкенд без него не стартует.
# REDIS_URL=redis://localhost:6379
