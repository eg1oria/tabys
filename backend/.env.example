NODE_ENV=development
PORT=4000

# Локальный Postgres (Homebrew), роль egor
DATABASE_URL="postgresql://egor@localhost:5432/tabys?schema=public"

# Фронтенд в dev; через запятую можно добавить прод-домен
CORS_ORIGINS=http://localhost:3000

# Не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000

# Первый администратор — используется только сид-скриптом
SEED_ADMIN_EMAIL=admin@tabys.kz
SEED_ADMIN_PASSWORD=

# Уведомления о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
