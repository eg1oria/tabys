# Входная точка: HTTPS-сертификат Caddy получает и продлевает сам
# (Let's Encrypt), для этого DNS домена должен указывать на сервер,
# а порты 80 и 443 — быть открыты.
#
# Наружу видны только сайт и /uploads. API бэкенда (/api/v1) не
# проксируется: к нему ходит только сервер Next из внутренней сети.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Фото каталога из медиатеки. Вложения заявок бэкенд по этому пути
	# не отдаёт — они только через авторизованный эндпоинт админки.
	handle /uploads/* {
		reverse_proxy backend:4000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# www → основной домен.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
