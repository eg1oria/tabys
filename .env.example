# Переменные для compose.yaml (прод на одном сервере). Скопируйте в .env.
# Для локальной разработки это не нужно — см. backend/.env.example
# и frontend/.env.example.

# Домен сайта: на него Caddy выпустит HTTPS-сертификат.
DOMAIN=tabys.kz
# Полный адрес сайта — для ссылок, sitemap, canonical и картинок.
SITE_URL=https://tabys.kz
# Почта для уведомлений Let's Encrypt (истечение сертификата и т. п.). Обязательна.
ACME_EMAIL=admin@tabys.kz

# Пароль Postgres внутри compose. Сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=

# Не короче 32 символов, разные. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Первый администратор — читается только сидом (docker compose run --rm migrate npm run db:seed).
# Пустой пароль — сид сгенерирует и напечатает его один раз.
SEED_ADMIN_EMAIL=admin@tabys.kz
SEED_ADMIN_PASSWORD=

# Уведомления о заявках в Telegram (необязательно).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
